local function GetAuraTarget(hrp)
    local best, minD = nil, _G.BiteRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Team ~= LocalPlayer.Team and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local pt = p.Character:FindFirstChild("HumanoidRootPart")
            if h and pt and h.Health > 0 then
                local d = (hrp.Position - pt.Position).Magnitude
                if d < minD and not (_G.BiteWallCheck and isBehindWall(pt)) then
                    minD = d; best = {hum=h, part=pt, name=p.Name, char=p.Character}
                end
            end
        end
    end
    if not best and cachedChambersFolder then
        pcall(function()
            for _, ch in ipairs(cachedChambersFolder:GetChildren()) do
                if LocalPlayer.Team and ch.Name ~= LocalPlayer.Team.Name then
                    local q = ch:FindFirstChild("Queen")
                    if q then
                        local h = q:FindFirstChildOfClass("Humanoid")
                        local pt = q:FindFirstChild("HumanoidRootPart")
                        if h and pt and h.Health > 0 then
                            local d = (hrp.Position - pt.Position).Magnitude
                            if d < minD and not (_G.BiteWallCheck and isBehindWall(pt)) then
                                best = {hum=h, part=pt, name="Queen "..ch.Name, char=q}
                            end
                        end
                    end
                end
            end
        end)
    end
    return best
end

local function GetStingAuraTarget(hrp)
    local best, minD = nil, _G.StingRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if _G.StingTeamCheck and p.Team == LocalPlayer.Team then continue end
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local pt = p.Character:FindFirstChild("HumanoidRootPart")
            if h and pt and h.Health > 0 and (h.Health/h.MaxHealth)*100 <= _G.StingHPThreshold then
                local d = (hrp.Position - pt.Position).Magnitude
                if d < minD and not (_G.StingWallCheck and isBehindWall(pt)) then
                    minD = d; best = {hum=h, part=pt, name=p.Name, char=p.Character}
                end
            end
        end
    end
    if not best and cachedChambersFolder then
        pcall(function()
            for _, ch in ipairs(cachedChambersFolder:GetChildren()) do
                if LocalPlayer.Team and ch.Name ~= LocalPlayer.Team.Name then
                    local q = ch:FindFirstChild("Queen")
                    if q then
                        local h = q:FindFirstChildOfClass("Humanoid")
                        local pt = q:FindFirstChild("HumanoidRootPart")
                        if h and pt and h.Health > 0 and (h.Health/h.MaxHealth)*100 <= _G.StingHPThreshold then
                            local d = (hrp.Position - pt.Position).Magnitude
                            if d < minD and not (_G.StingWallCheck and isBehindWall(pt)) then
                                best = {hum=h, part=pt, name="Queen "..ch.Name, char=q}
                            end
                        end
                    end
                end
            end
        end)
    end
    return best
end

