local SharedRaycastParams = RaycastParams.new()
SharedRaycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function isBehindWall(targetPart)
    if not targetPart then return false end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local origin, destination = root.Position, targetPart.Position
    local direction = destination - origin
    local maxDist = direction.Magnitude
    local currentOrigin = origin
    local ignoreList = {}
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(ignoreList, p.Character) end end
    if char then table.insert(ignoreList, char) end
    if targetPart.Parent:IsA("Model") and not table.find(ignoreList, targetPart.Parent) then table.insert(ignoreList, targetPart.Parent) end
    while maxDist > 0.1 do
        direction = destination - currentOrigin
        SharedRaycastParams.FilterDescendantsInstances = ignoreList
        local res = workspace:Raycast(currentOrigin, direction, SharedRaycastParams)
        if res then
            local hp = res.Instance
            if not hp.CanCollide or hp.Transparency >= 0.5 or hp:FindFirstAncestorOfClass("Accessory") then
                table.insert(ignoreList, hp)
                currentOrigin = res.Position + direction.Unit * 0.1
                maxDist = (destination - currentOrigin).Magnitude
            else return true end
        else return false end
    end
    return false
end

