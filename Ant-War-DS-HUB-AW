local function UpdateMonitor()
    if not _G.MonitorEnabled or not MonitorFrame then
        if MonitorFrame then MonitorFrame.Visible = false end
        if MonitorBillboard then MonitorBillboard.Enabled = false end
        return
    end
    local tFrame, tStats
    if _G.MonitorPosition == "Head" then
        MonitorFrame.Visible = false; MonitorBillboard.Enabled = true
        MonitorBillboard.Adornee = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
        tFrame, tStats = MonitorHeadFrame, MonitorHeadStatsLabel
    else
        MonitorBillboard.Enabled = false; MonitorFrame.Visible = true
        tFrame, tStats = MonitorFrame, MonitorStatsLabel
    end
    if MonitorLabel and tFrame then MonitorLabel.Parent = tFrame end
    if tStats then
        tStats.Text = string.format("<font color='#FFA500'>DMG: %d</font>  <font color='#00FF00'>Kills: %d</font>  <font color='#FF0000'>Deaths: %d</font>",
            _G.TotalDamage, _G.TotalKills, _G.TotalDeaths)
    end
    local myTeam = LocalPlayer.Team
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local r, g, b = math.floor(myTeamColor.R*255), math.floor(myTeamColor.G*255), math.floor(myTeamColor.B*255)
    MonitorLabel.Text = string.format("<font color='#AAAAAA'>Team:</font> <font color='rgb(%d,%d,%d)'>%s</font>\n", r,g,b, myTeamQueenName)

    local display = ""
    local larvaeCount = 0
    for _, v in pairs(WorldEntities.Larvae) do if v and v.Parent then larvaeCount = larvaeCount + 1 end end
    display = display .. "🐛 Larvae: " .. larvaeCount .. "\n"

    if not myChar or (myHum and myHum.Health <= 0) then
        if not isDeadNow then isDeadNow = true; manualRespawnTimer = 7.0; _G.TotalDeaths = _G.TotalDeaths + 1 end
        display = display .. string.format("<font color='#FF3333'>⚠️ Died. Respawn: %.1fs</font>\n", math.max(0, manualRespawnTimer))
        if manualRespawnTimer > 0 then manualRespawnTimer = manualRespawnTimer - 0.05 end
    else isDeadNow = false end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pPos = p.Character.HumanoidRootPart.Position
            local pHum = p.Character:FindFirstChildOfClass("Humanoid")
            local distMe = myHRP and (pPos - myHRP.Position).Magnitude or 999
            if p.Team ~= myTeam and pHum then
                local prev = enemyPreviousHealth[p.UserId] or pHum.Health
                if pHum.Health < prev and MyDamageTargets[pHum] and tick() - MyDamageTargets[pHum] <= 5 then
                    lastDamageDealt = math.floor(prev - pHum.Health)
                    _G.TotalDamage = _G.TotalDamage + lastDamageDealt
                    damageFlashTimer = 2.0
                end
                if pHum.Health <= 0 and prev > 0 and MyDamageTargets[pHum] and tick() - MyDamageTargets[pHum] <= 5 then
                    _G.TotalKills = _G.TotalKills + 1
                    _G.DeathMsg = "Killed " .. p.DisplayName; _G.DeathTimer = 2
                    SetUIFlash(Color3.fromRGB(255,255,255), 0.6)
                end
                enemyPreviousHealth[p.UserId] = pHum.Health
            elseif p ~= LocalPlayer and pHum then
                if pHum.Health <= 0 and (allyHealthCache[p.UserId] or 100) > 0 then
                    _G.DeathMsg = p.DisplayName .. " was killed!"; _G.DeathTimer = 2
                    SetUIFlash(Color3.fromRGB(0,150,255), 0.6)
                elseif (allyHealthCache[p.UserId] or 100) > pHum.Health then allyAlertTimer = 2 end
                allyHealthCache[p.UserId] = pHum.Health
            end
        end
    end

    for _, q in pairs(cachedQueens) do
        local hum = q.Model:FindFirstChildOfClass("Humanoid")
        if hum and q.TeamName == myTeamQueenName then
            local pct = math.floor((hum.Health/hum.MaxHealth)*100)
            if hum.Health < lastQueenHealth then _G.QueenAttackTimer = 2 end
            lastQueenHealth = hum.Health
            local col = pct > 50 and "#00FF00" or (pct > 25 and "#FFFF00" or "#FF0000")
            display = display .. "👑 Queen: <font color='"..col.."'>" .. pct .. "%</font>\n"
        end
    end

    if damageFlashTimer > 0 then
        display = display .. "<font color='#FFD700'>💥 DMG: " .. lastDamageDealt .. "</font>\n"
        damageFlashTimer = damageFlashTimer - 0.05
    end
    if _G.QueenAttackTimer > 0 then
        display = display .. "⚠️ <font color='#FF0000'>QUEEN UNDER ATTACK!</font>\n"
        _G.QueenAttackTimer = _G.QueenAttackTimer - 0.05
    end
    if allyAlertTimer > 0 then
        display = display .. "🛡️ <font color='#00BFFF'>Ally taking damage!</font>\n"
        allyAlertTimer = allyAlertTimer - 0.05
    end
    if _G.DeathTimer > 0 then
        display = display .. string.format("<font color='#FFFFFF'>💀 %s</font>\n", _G.DeathMsg)
        _G.DeathTimer = _G.DeathTimer - 0.05
    end
    MonitorLabel.Text = MonitorLabel.Text .. display
end
