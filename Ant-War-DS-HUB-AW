local function _getFarmOffset()
    return detectMajor() and -12 or -10
end

local function isPlayerNearby(lv)
    local p = lv:IsA("Model") and lv:GetModelCFrame().Position or lv.Position
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
            if (pl.Character.HumanoidRootPart.Position - p).Magnitude <= 10 then return true end
        end
    end
    return false
end

-- ⭐ CORRIGIDO: Função auxiliar robusta para obter o Y do chão
local function getGroundY(char, hrp)
    if not hrp or not char then return 0 end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    local origin = hrp.Position + Vector3.new(0, 2, 0)
    local result = workspace:Raycast(origin, Vector3.new(0, -200, 0), params)
    if result then
        return result.Position.Y
    end
    return hrp.Position.Y
end

-- ⭐ CORRIGIDO: Snap para o chão real, não para o teto
local function snapGround(char, hrp, fallbackY)
    if not hrp or not hrp.Parent then return end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    local result = workspace:Raycast(hrp.Position + Vector3.new(0, 2, 0), Vector3.new(0, -200, 0), params)
    if result then
        hrp.CFrame = CFrame.new(hrp.Position.X, result.Position.Y + 3, hrp.Position.Z) * hrp.CFrame.Rotation
    elseif fallbackY then
        hrp.CFrame = CFrame.new(hrp.Position.X, fallbackY, hrp.Position.Z) * hrp.CFrame.Rotation
    end
end

local function restoreFarmState(savedState, char, hrp)
    InvTargetY = nil
    _G.InvisibleEnabled = false
    task.wait(0.05)
    _G.SpeedBypassEnabled = savedState.speedBypass
    _G.TargetWalkSpeed = savedState.speed
    if hrp and hrp.Parent then
        snapGround(char, hrp, savedState.originalY)
        OriginalY = hrp.Position.Y
        if savedState.invisible then
            InvTargetY = OriginalY + _getFarmOffset()
            _G.InvisibleEnabled = true
        end
    end
    updateSize()
end

local function safeTween(hrp, targetCF, duration, checkFarm)
    if not hrp or not hrp.Parent then return false end
    local wasAnchored = hrp.Anchored
    hrp.Anchored = true
    _G._SuspendYHold = true
    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCF})
    tw:Play()
    local start = tick()
    local maxWait = duration + 3
    while tick() - start < maxWait do
        if checkFarm and not _G.AutoFarm then
            pcall(function() tw:Cancel() end); hrp.Anchored = wasAnchored; _G._SuspendYHold = false; return false
        end
        if not hrp.Parent then
            pcall(function() tw:Cancel() end); _G._SuspendYHold = false; return false
        end
        if tw.PlaybackState ~= Enum.PlaybackState.Playing then break end
        task.wait(0.03)
    end
    hrp.Anchored = wasAnchored
    _G._SuspendYHold = false
    return true
end

local function moveHorizontal(hrp, targetX, targetZ, fixedY, speed, checkFarm)
    if not hrp or not hrp.Parent then return false end
    local dx = targetX - hrp.Position.X
    local dz = targetZ - hrp.Position.Z
    local horizDist = math.sqrt(dx*dx + dz*dz)
    if horizDist < 3 then return true end
    local duration = math.max(horizDist / math.max(speed or 30, 1), 0.15)
    local targetCF = CFrame.new(targetX, fixedY, targetZ) * hrp.CFrame.Rotation
    return safeTween(hrp, targetCF, duration, checkFarm)
end

local function smoothVertical(hrp, targetY, duration, checkFarm)
    if not hrp or not hrp.Parent then return end
    local targetCF = CFrame.new(hrp.Position.X, targetY, hrp.Position.Z) * hrp.CFrame.Rotation
    safeTween(hrp, targetCF, duration or 0.3, checkFarm)
end

local function moveToFarmCycle()
    print("[Farm] === INÍCIO CICLO ===")
    if not _G.HomePos then
        warn("[Farm] ❌ HomePos é nil! Clique em 'Save Drop Position' primeiro.")
        return
    end
    if _G._FarmCycleBusy then return end
    _G._FarmCycleBusy = true

    updateSize()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        warn("[Farm] ❌ HRP/Humanoid não encontrado")
        _G._FarmCycleBusy = false
        return
    end

    local speed = _G.MoveToSpeed or 30
    local waitTime = _G.MoveToWaitTime or 15
    local offset = _getFarmOffset()
    local isMajor = string.find(char.Name, "Major") ~= nil
    local maxAllowed = isMajor and 4 or 3
    local targetLarvae = math.min(_G.MoveToLarvaePerCycle or maxAllowed, maxAllowed)

    print("[Farm] speed:", speed, "targetLarvae:", targetLarvae, "(max:", maxAllowed, ") wait:", waitTime, "offset:", offset, "isMajor:", isMajor)

    local savedState = {
        invisible = _G.InvisibleEnabled,
        speedBypass = _G.SpeedBypassEnabled,
        speed = _G.TargetWalkSpeed or 16,
        originalY = OriginalY or hrp.Position.Y,
    }

    _G.InvisibleEnabled = true
    _G.SpeedBypassEnabled = true
    _G.TargetWalkSpeed = speed
    hum.WalkSpeed = speed
    
    -- ⭐ CORRIGIDO: Usa o chão real como base
    local startGroundY = getGroundY(char, hrp)
    OriginalY = startGroundY
    InvTargetY = OriginalY + offset

    _G.GatherCount = 0
    local attempted = {}
    local scanAttempts = 0
    local MAX_SCAN_ATTEMPTS = 10
    local RESCAN_WAIT = 3

    while _G.AutoFarm and _G.GatherCount < targetLarvae do
        local currentLarvae = {}
        local seen = {}
        for _, v in ipairs(workspace:GetDescendants()) do
            if v.Name == "Larvae" and v.Parent and not v:IsDescendantOf(char) and not seen[v] and not attempted[v] and not isPlayerNearby(v) then
                seen[v] = true; table.insert(currentLarvae, v)
            end
        end
        if WorldEntities and WorldEntities.Larvae then
            for _, v in pairs(WorldEntities.Larvae) do
                if v.Parent and not v:IsDescendantOf(char) and not seen[v] and not attempted[v] and not isPlayerNearby(v) then
                    seen[v] = true; table.insert(currentLarvae, v)
                end
            end
        end

        table.sort(currentLarvae, function(a, b)
            local pa = a:IsA("Model") and a:GetModelCFrame().Position or a.Position
            local pb = b:IsA("Model") and b:GetModelCFrame().Position or b.Position
            return (hrp.Position - pa).Magnitude < (hrp.Position - pb).Magnitude
        end)

        if #currentLarvae == 0 then
            if _G.GatherCount >= targetLarvae then break end
            scanAttempts = scanAttempts + 1
            if scanAttempts > MAX_SCAN_ATTEMPTS then
                warn("[Farm] ⚠️ Timeout esperando larvas (".._G.GatherCount.."/"..targetLarvae..")")
                break
            end
            print("[Farm] Sem larvas. Aguardando respawn... ("..scanAttempts.."/"..MAX_SCAN_ATTEMPTS..")")
            task.wait(RESCAN_WAIT)
            attempted = {}
            continue
        end

        scanAttempts = 0
        local gotAny = false

        for i, lv in ipairs(currentLarvae) do
            if not _G.AutoFarm then break end
            if _G.GatherCount >= targetLarvae then break end
            if attempted[lv] then continue end
            attempted[lv] = true
            if not lv.Parent or isPlayerNearby(lv) then continue end

            local cf = lv:IsA("Model") and lv:GetModelCFrame() or lv.CFrame
            local targetPos = cf.Position
            print("[Farm] Larva", i, "| progresso:", _G.GatherCount, "/", targetLarvae)

            -- ⭐ CORRIGIDO: Calcula o Y do subsolo baseado no chão LOCAL da larva, não no teto
            local larvaGroundY = getGroundY(char, hrp) -- Usa a posição atual do jogador como referência segura
            local undergroundY = larvaGroundY + offset
            InvTargetY = undergroundY
            
            local arrived = moveHorizontal(hrp, targetPos.X, targetPos.Z, undergroundY, speed, true)

            if arrived and _G.AutoFarm and lv.Parent then
                -- FASE 2: SUBIR SUAVE para coletar
                local collectY = targetPos.Y + 2
                smoothVertical(hrp, collectY, 0.25, true)
                InvTargetY = collectY
                task.wait(0.1)

                if lv.Parent then
                    local t0 = tick()
                    while tick() - t0 < 0.3 do
                        if not _G.AutoFarm then break end
                        if not lv.Parent then break end
                        pcall(function() LarvaeEvent:FireServer("Gather", lv) end)
                        task.wait(0.02)
                    end

                    -- FASE 3: DESCER SUAVE de volta ao subsolo
                    smoothVertical(hrp, undergroundY, 0.2, true)
                    InvTargetY = undergroundY
                    task.wait(0.05)

                    if not lv.Parent then
                        _G.GatherCount = _G.GatherCount + 1
                        gotAny = true
                        print("[Farm] ✔ Coletada! Total:", _G.GatherCount, "/", targetLarvae)
                    else
                        print("[Farm] ✘ Larva não coletada (pode ter sumido)")
                    end
                else
                    print("[Farm] ✘ Larva já foi coletada por outro player")
                end
            end
        end

        if _G.GatherCount >= targetLarvae then break end

        if not gotAny then
            scanAttempts = scanAttempts + 1
            if scanAttempts > MAX_SCAN_ATTEMPTS then
                warn("[Farm] ⚠️ Timeout. Encerrando com ".._G.GatherCount.."/"..targetLarvae)
                break
            end
            print("[Farm] Nenhuma coletada nesta rodada. Reescaneando...")
            task.wait(RESCAN_WAIT)
            attempted = {}
        end
    end

    -- Entregar no HomePos
    local hasEnough = _G.GatherCount > 0
    if _G.AutoFarm and _G.HomePos and hrp.Parent and hasEnough then
        print("[Farm] Indo para home (coletadas:", _G.GatherCount, "/", targetLarvae, ")")

        -- ⭐ CORRIGIDO: Raycast robusto para encontrar o chão real na base, ignorando o teto
        local homeParams = RaycastParams.new()
        homeParams.FilterType = Enum.RaycastFilterType.Exclude
        homeParams.FilterDescendantsInstances = {char}
        -- Lança o raio de bem alto (Y=500) para baixo (Y=-1000) para garantir que pegue o chão da base
        local homeResult = workspace:Raycast(
            Vector3.new(_G.HomePos.Position.X, 500, _G.HomePos.Position.Z), 
            Vector3.new(0, -1500, 0), 
            homeParams
        )
        
        local safeHomeY = homeResult and homeResult.Position.Y or _G.HomePos.Position.Y
        
        local homeUndergroundY = safeHomeY + offset
        InvTargetY = homeUndergroundY
        moveHorizontal(hrp, _G.HomePos.Position.X, _G.HomePos.Position.Z, homeUndergroundY, speed, true)

        if _G.AutoFarm and hrp.Parent then
            -- SUBIR SUAVE para entregar
            smoothVertical(hrp, safeHomeY + 2, 0.35, true)
            InvTargetY = safeHomeY + 2
            task.wait(0.1)

            local wStart = tick()
            while tick() - wStart < waitTime do
                if not _G.AutoFarm then break end
                task.wait(0.1)
            end

            if hrp.Parent then
                -- DESCER SUAVE de volta
                smoothVertical(hrp, homeUndergroundY, 0.3, true)
                InvTargetY = homeUndergroundY
                task.wait(0.05)
            end
        end
    end

    print("[Farm] Entregues:", _G.GatherCount, "/", targetLarvae)
    restoreFarmState(savedState, char, hrp)
    _G._FarmCycleBusy = false
    print("[Farm] === FIM CICLO ===")
end

local function runFarmCycle()
    moveToFarmCycle()
end

