local function getAutoKillOffset()
    return detectMajor() and -12 or -10
end

local function passKingdomFilter(p)
    if p.Team == LocalPlayer.Team then return false end
    if _G.AutoKillKingdom == "All" then return true end
    local pt = p.Team and p.Team.Name or ""
    return pt == _G.AutoKillKingdom
end

local function getClosestEnemyTo(pos)
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and passKingdomFilter(p) then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local d = (pos - r.Position).Magnitude
                if d < bd then bd = d; best = p end
            end
        end
    end
    return best
end

local function getMediumDistanceEnemy(currentTarget)
    local best, bestScore = nil, math.huge
    local myChar = LocalPlayer.Character
    local myR = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myR then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p ~= currentTarget and p.Character and passKingdomFilter(p) then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local d = (myR.Position - r.Position).Magnitude
                if d >= 25 and d <= 150 then
                    local score = math.abs(d - 50)
                    if score < bestScore then bestScore = score; best = p end
                end
            end
        end
    end
    return best
end

local function getEnemyFromDifferentKingdom(excludeKingdom)
    local best, bd = nil, math.huge
    local myChar = LocalPlayer.Character
    local myR = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myR then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and passKingdomFilter(p) then
            local pt = p.Team and p.Team.Name or ""
            if pt ~= excludeKingdom then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if h and r and h.Health > 0 then
                    local d = (myR.Position - r.Position).Magnitude
                    if d < bd then bd = d; best = p end
                end
            end
        end
    end
    return best
end

-- ⭐ CORRIGIDO: Raycast a partir de Y+2 para baixo, evitando acertar o teto
local function computeSelfUndergroundY(ch, r, offset)
    local gp = RaycastParams.new()
    gp.FilterType = Enum.RaycastFilterType.Exclude
    gp.FilterDescendantsInstances = {ch}
    local origin = r.Position + Vector3.new(0, 2, 0)
    local gr = workspace:Raycast(origin, Vector3.new(0, -200, 0), gp)
    if gr then 
        return gr.Position.Y + offset 
    end
    return OriginalY and (OriginalY + offset) or (r.Position.Y + offset)
end

