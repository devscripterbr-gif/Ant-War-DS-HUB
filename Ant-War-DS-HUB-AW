function DSHubLibrary.Init(options)
    options = options or {}
    local hubName = options.Name or "DS HUB AW"
    local versionText = options.Version or "v1.0 BETA"
    local configFile = options.ConfigFile or "DSHubAW_v1.json"
    local canWrite = typeof(writefile) == "function"
    local canRead = typeof(readfile) == "function"
    local canCheck = typeof(isfile) == "function"
    local function Save(d) if canWrite then pcall(function() writefile(configFile, HttpService:JSONEncode(d)) end) end
    local function Load()
        if canRead and canCheck then
            local ok, r = pcall(function() if isfile(configFile) then return HttpService:JSONDecode(readfile(configFile)) end end)
            if ok and type(r) == "table" then return r end
        end
        return nil
    end
    local savedData = Load() or { NormalPosX=0, NormalPosY=0, NormalScaleX=0.5, NormalScaleY=0.5, MinPosX=0, MinPosY=0, MinScaleX=0.5, MinScaleY=0.5, Toggles={} }

