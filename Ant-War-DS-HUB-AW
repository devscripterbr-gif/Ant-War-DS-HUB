local function SetupESP(model)
    if not model then return nil, nil end
    local hl = model:FindFirstChild("ESPHighlight")
    if not hl then hl = Instance.new("Highlight"); hl.Name = "ESPHighlight"; hl.Parent = model end
    local head = model:FindFirstChild("Head") or model.PrimaryPart or model
    if model:IsA("BasePart") then head = model end
    local ng = model:FindFirstChild("NameESP")
    if not ng then
        ng = Instance.new("BillboardGui"); ng.Name = "NameESP"; ng.Adornee = head
        ng.Size = UDim2.new(0,150,0,50); ng.AlwaysOnTop = true
        ng.ExtentsOffset = Vector3.new(0,3,0); ng.Parent = model
        local lb = Instance.new("TextLabel"); lb.Name = "TextLabel"
        lb.Size = UDim2.new(1,0,1,0); lb.BackgroundTransparency = 1
        lb.TextStrokeTransparency = 0.5; lb.Font = Enum.Font.GothamBold; lb.Parent = ng
    end
    return hl, ng:FindFirstChild("TextLabel")
end

local function getColor(entity, isQueen)
    local hum = entity:FindFirstChildOfClass("Humanoid")
    if not hum then return Color3.new(1,1,1) end
    if hum.Health <= 0 then return Color3.fromRGB(40,5,5) end
    local base = Color3.new(1,1,1)
    local tName = ""
    if isQueen then tName = entity.Parent and entity.Parent.Name or ""
    else local pl = Players:GetPlayerFromCharacter(entity); if pl and pl.Team then tName = pl.Team.Name end end
    if _G.UseCustomESPColors then
        if tName == "Concrete Clan" then base = _G.ESPConcreteClanColor
        elseif tName == "Leaf Kingdom" then base = _G.ESPLeafKingdomColor
        elseif tName == "Fire Nation" then base = _G.ESPFireNationColor
        elseif tName == "Golden Empire" then base = _G.ESPGoldenEmpireColor
        else base = Config.teamColors[tName] or Color3.new(1,1,1) end
    else base = Config.teamColors[tName] or Color3.new(1,1,1) end
    return base
end

