    elseif o.Name == "Larvae" and (o:IsA("Model") or o:IsA("BasePart")) then WorldEntities.Larvae[o] = o
    elseif o:IsA("ProximityPrompt") then WorldEntities.Prompts[o] = o end
end
local function UnTrack(o) WorldEntities.Queens[o]=nil; WorldEntities.Larvae[o]=nil; WorldEntities.Prompts[o]=nil end
for _, o in ipairs(workspace:GetDescendants()) do Track(o) end
workspace.DescendantAdded:Connect(Track)
workspace.DescendantRemoving:Connect(UnTrack)

local function CleanESP()
    local function hide(c)
        if not c then return end
        local h, n = c:FindFirstChild("ESPHighlight"), c:FindFirstChild("NameESP")
        if h then h.Enabled = false end
        if n and n:FindFirstChild("TextLabel") then n.TextLabel.Visible = false end
    end
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then hide(p.Character) end end
    for _, o in pairs(WorldEntities.Queens) do hide(o) end
    for _, o in pairs(WorldEntities.Larvae) do hide(o) end
end

local function UpdateESP()
    if not _G.ESPEnabled then CleanESP() return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h, l = SetupESP(p.Character)
            if h and l then
                local col = getColor(p.Character, false)
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                h.FillColor = col; h.FillTransparency = _G.ESPFillTransparency
                h.OutlineTransparency = _G.ESPOutlineTransparency; h.Enabled = true
                l.TextColor3 = col; l.TextSize = _G.ESPNameSize; l.Visible = _G.ESPShowNames
                local tn = (p.Team and p.Team.Name) or "Neutral"
                local hp = hum and math.max(0, math.floor(hum.Health)) or 0
                l.Text = string.format("[HP: %d] [%s]\n%s", hp, tn, p.Name)
            end
        end
    end
    for _, q in pairs(WorldEntities.Queens) do
        if q and q.Parent and _G.ESPQueenEnabled then
            local hum = q:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local h, l = SetupESP(q)
                if h and l then
                    local tn = q.Parent.Name
                    local col = getColor(q, true)
                    h.FillColor = col; h.FillTransparency = _G.ESPFillTransparency
                    h.OutlineTransparency = _G.ESPOutlineTransparency; h.Enabled = true
                    l.TextColor3 = col; l.TextSize = _G.ESPNameSize; l.Visible = _G.ESPShowNames
                    l.Text = string.format("[Queen HP: %d]\n[%s]", math.floor(hum.Health), tn)
                end
            end
        end
    end
    for _, lv in pairs(WorldEntities.Larvae) do
        if lv and lv.Parent and _G.ESPLarvaeEnabled then
            local h, l = SetupESP(lv)
            if h and l then
                local col = _G.UseCustomESPColors and _G.ESPLarvaeColor or Color3.new(1,1,1)
                h.FillColor = col; h.FillTransparency = _G.ESPFillTransparency
                h.OutlineTransparency = _G.ESPOutlineTransparency; h.Enabled = true
                l.TextColor3 = col; l.TextSize = _G.ESPNameSize; l.Visible = _G.ESPShowNames
                l.Text = "Larvae"
            end
        end
    end
end
