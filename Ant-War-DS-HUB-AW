    MainContainer.BackgroundTransparency = 1; MainContainer.Visible = false

    local Main = Instance.new("Frame", MainContainer)
    Main.Size = UDim2.new(1,0,1,0); Main.BackgroundColor3 = THEME.Background
    Main.BorderSizePixel = 0; addCorner(Main, 12)

    local BorderFrame = Instance.new("Frame", MainContainer)
    BorderFrame.Size = UDim2.new(1,0,1,0); BorderFrame.BackgroundTransparency = 1; BorderFrame.ZIndex = 20
    addCorner(BorderFrame, 12)
    local MainStroke = Instance.new("UIStroke", BorderFrame)
    MainStroke.Color = THEME.Accent; MainStroke.Thickness = 0.8
    MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local InnerWrapper = Instance.new("Frame", Main)
    InnerWrapper.Size = UDim2.new(1,0,1,0); InnerWrapper.BackgroundTransparency = 1
