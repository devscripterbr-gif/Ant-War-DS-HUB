        local dragging, dragStart, startPos
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startPos = gui.Position
                local conn
                conn = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false; SavePos(); if conn then conn:Disconnect() end
                    end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                local newX, newY = startPos.X.Offset + delta.X, startPos.Y.Offset + delta.Y
                local vp, ab = Camera.ViewportSize, gui.AbsoluteSize
                local hw, hh = ab.X/2, ab.Y/2
                newX = math.clamp(newX, -(vp.X/2)+hw, (vp.X/2)-hw)
                newY = math.clamp(newY, -(vp.Y/2)+hh, (vp.Y/2)-hh)
                gui.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
            end
        end)
